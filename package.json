{
  "name": "rm-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix --ignore-pattern=**/node_modules/** --ignore-pattern=**/src-tauri/** --ignore-pattern=**/dist/**",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint:check": "oxlint . --ignore-pattern=**/node_modules/** --ignore-pattern=**/src-tauri/** --ignore-pattern=**/dist/**",
    "lint:eslint:check": "eslint .",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "tauri": "tauri"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.56.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^15.0.0",
    "ai-elements-vue": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
