{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rm-manager",
  "version": "0.1.0",
  "identifier": "com.swaince.rmmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rm-manager",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "title": "速记",
        "url": "index.html?capture=1",
        "width": 480,
        "height": 300,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
